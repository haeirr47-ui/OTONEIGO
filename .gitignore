# Frontend package-manager state: npm with frontend/package-lock.json is the
# pinned toolchain (scripts/bootstrap.ps1 runs `npm ci`); a stale pnpm lock
# must not enter the repository.
/frontend/pnpm-lock.yaml

# Compiler/bundler leftovers
*.tsbuildinfo
/frontend/.vite/

# Stray local packages and binaries; distributable artifacts live in bin/ (ignored)
*.exe
*.msi
*.msix
*.zip
*.7z
*.sha256
